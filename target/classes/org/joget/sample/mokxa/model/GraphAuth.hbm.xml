<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>

    <class name="org.joget.mokxa.model.GraphAuth" entity-name="GraphAuth" table="graph_auth">

        <id name="id" column="id" type="string"/>

        <property name="jogetUsername" column="joget_username"/>
        <property name="tenantId" column="tenant_id"/>
        <property name="msOid" column="ms_oid"/>
        <property name="msUpn" column="ms_upn"/>
        <property name="scopes" column="scopes"/>

        <property name="tokenCacheEnc" column="token_cache_enc" type="binary"/>
        <property name="refreshToken" column="refresh_token"/>
        <property name="expiresAt" column="expires_at"/>

        <property name="cacheFormat" column="cache_format"/>
        <property name="status" column="status"/>

        <property name="lastTokenRefreshAt" column="last_token_refresh_at"/>
        <property name="updatedAt" column="updated_at"/>

        <property name="accessTokenDebug" column="access_token_debug"/>

    </class>

</hibernate-mapping>
